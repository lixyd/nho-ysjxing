# 统一换行符为 LF，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 明确二进制文件，禁止换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.bin binary
*.onnx binary

# Windows 批处理必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 文本文件
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.html text eol=lf
*.sh   text eol=lf
*.spec text eol=lf
